<Project Sdk="Microsoft.NET.Sdk">

  <!-- Harmony ordering against other mods (Troop Equipment Upgrade), run on the GAME's own 0Harmony.dll
       (net472, like the game). Needs the Bannerlord.Harmony module (HarmonyBinFolder / GameFolder, as the module). -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TroopTrainingRequirement.Core\TroopTrainingRequirement.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <HarmonyBinFolder Condition="!Exists('$(HarmonyBinFolder)\0Harmony.dll')">$(GameFolder)\Modules\Bannerlord.Harmony\bin\Win64_Shipping_Client</HarmonyBinFolder>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyBinFolder)\0Harmony.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
